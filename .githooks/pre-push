#!/bin/sh
# Reject pushes that don't bump the version in changelog/*.md.
# The app's version is the highest vX.Y.Z in a changelog heading (server.py
# get_latest_version), so every push must add a new, higher version heading
# and must not still contain an "## Unreleased" section. See CLAUDE.md.

ZERO=0000000000000000000000000000000000000000

# Highest X.Y.Z in a changelog heading at commit $1 (empty if none).
version_at() {
    git grep -h -E '^ {0,3}#{1,6}[[:space:]].*[0-9]+\.[0-9]+\.[0-9]+' "$1" -- 'changelog/*.md' 2>/dev/null \
        | grep -o -E '[0-9]+\.[0-9]+\.[0-9]+' \
        | sort -t. -k1,1n -k2,2n -k3,3n | tail -n 1
}

# 0 if $1 > $2 (both X.Y.Z; empty $2 counts as lowest).
version_gt() {
    [ -z "$2" ] && return 0
    [ "$1" = "$2" ] && return 1
    top=$(printf '%s\n%s\n' "$1" "$2" | sort -t. -k1,1n -k2,2n -k3,3n | tail -n 1)
    [ "$top" = "$1" ]
}

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    # Branch deletion or tag push: nothing to check.
    case "$local_sha" in "$ZERO"*) continue ;; esac
    case "$remote_ref" in refs/tags/*) continue ;; esac

    branch=${remote_ref#refs/heads/}

    if git grep -q -E '^ {0,3}#{1,6}[[:space:]]+Unreleased' "$local_sha" -- 'changelog/*.md' 2>/dev/null; then
        echo "pre-push: '$branch' still has an '## Unreleased' changelog section." >&2
        echo "          Rename it to the next version heading before pushing (see CLAUDE.md)." >&2
        status=1
        continue
    fi

    base=
    case "$remote_sha" in
        "$ZERO"*) base=$(git merge-base "$local_sha" origin/main 2>/dev/null) ;;
        *) git cat-file -e "$remote_sha^{commit}" 2>/dev/null && base=$remote_sha ;;
    esac
    if [ -z "$base" ]; then
        # Remote tip unknown locally (e.g. not fetched) and no origin/main: can't compare.
        echo "pre-push: warning: no base to compare '$branch' against; skipping version check." >&2
        continue
    fi
    [ "$base" = "$local_sha" ] && continue   # nothing new to push

    old=$(version_at "$base")
    new=$(version_at "$local_sha")
    if [ -z "$new" ] || ! version_gt "$new" "$old"; then
        if [ -n "$old" ]; then
            next=$(echo "$old" | awk -F. '{printf "%d.%d.%d", $1, $2, $3 + 1}')
        else
            next=1.0.0
        fi
        echo "pre-push: version not bumped for '$branch' (still v${old:-none})." >&2
        echo "          Add a '## v$next' changelog entry and commit it as 'Bump version to v$next'." >&2
        echo "          See CLAUDE.md." >&2
        status=1
    fi
done

exit $status
